<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShahWatches - Premium Watches PK</title>
<style>
body{font-family:Arial,sans-serif;margin:0;background:#111;color:#fff}
header{background:#000;padding:15px;text-align:center;border-bottom:2px solid gold}
header h1{color:gold;margin:0}
.banner{background:linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.7)),url('https://images.unsplash.com/photo-1524805444973-bf35c3d9b4b6');background-size:cover;padding:60px 20px;text-align:center}
.banner h2{font-size:35px;color:gold}
.btn{background:gold;color:#000;padding:12px 25px;text-decoration:none;font-weight:bold;border-radius:5px;display:inline-block;margin-top:10px}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;padding:20px}
.card{background:#222;border-radius:10px;overflow:hidden;text-align:center;border:1px solid #333}
.card img{width:100%;height:250px;object-fit:cover}
.card h3{color:gold}
.card p{color:#ccc}
.card button{background:gold;border:none;padding:10px 20px;font-weight:bold;border-radius:5px;margin-bottom:15px;cursor:pointer}
footer{background:#000;padding:15px;text-align:center;color:#888;margin-top:20px}
.whatsapp{position:fixed;bottom:20px;right:20px;background:#25D366;color:#fff;padding:15px 20px;border-radius:50px;text-decoration:none;font-weight:bold}
</style>
</head>
<body>
<header>
<h1>SHAH WATCHES</h1>
<p>Premium Quality Watches in Pakistan</p>
</header>

<div class="banner">
<h2>Luxury Watches Collection</h2>
<p>Cash on Delivery All Over Pakistan</p>
<a class="btn" href="https://wa.me/923000000000">Order on WhatsApp</a>
</div>

<div class="products">
<div class="card">
<img src="https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3" alt="watch">
<h3>Rolex Premium</h3>
<p>Rs. 4,500</p>
<button>Buy Now</button>
</div>
<div class="card">
<img src="https://images.unsplash.com/photo-1548169874-53e85f753f1e" alt="watch">
<h3>Patek Philippe</h3>
<p>Rs. 5,000</p>
<button>Buy Now</button>
</div>
<div class="card">
<img src="https://images.unsplash.com/photo-1539874754764-5a9e128a0d1f" alt="watch">
<h3>Omega Edition</h3>
<p>Rs. 3,999</p>
<button>Buy Now</button>
</div>
</div>

<footer>
<p>© 2025 ShahWatches.pk - All Rights Reserved</p>
</footer>

<a class="whatsapp" href="https://wa.me/923000000000">WhatsApp</a>
</body>
</html>
